<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="partas-local" value="feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="partas-local">
      <package pattern="Partas.Solid" />
      <package pattern="Partas.Solid.FablePlugin" />
      <package pattern="Partas.Nacara.*" />
    </packageSource>
    <!-- The live examples restore from .nacara/partas-solid, whose generated nuget.config names
         this same folder feed0 and inherits this mapping. Without it, a cold cache cannot find
         Partas.Solid there. -->
    <packageSource key="feed0">
      <package pattern="Partas.Solid" />
      <package pattern="Partas.Solid.FablePlugin" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
