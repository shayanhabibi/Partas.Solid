<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="partas-local" value="feed" />
    <add key="xantham" value="https://nuget.cloudsmith.io/shayanhabibi/xantham/v3/index.json" />
    <add key="partas-animejs" value="https://nuget.cloudsmith.io/shayanhabibi/partas-animejs/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="partas-local">
      <package pattern="Partas.Nacara.*" />
    </packageSource>
    <!-- The live examples restore from .nacara/partas-solid and inherit this mapping. They compile
         against src/Partas.Solid; only PARTAS_SOLID_FEED, which the generated nuget.config names
         feed0, serves Partas.Solid packages. -->
    <packageSource key="feed0">
      <package pattern="Partas.Solid" />
      <package pattern="Partas.Solid.FablePlugin" />
    </packageSource>
    <packageSource key="xantham">
      <package pattern="Xantham.*" />
    </packageSource>
    <!-- Partas.AnimeJs 0.1 (the landing page's demo); nuget.org only has the 0.0.x releases. -->
    <packageSource key="partas-animejs">
      <package pattern="Partas.AnimeJs" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
