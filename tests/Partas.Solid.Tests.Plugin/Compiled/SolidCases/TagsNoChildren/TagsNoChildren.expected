

export function MyTag(props) {
    const PARTAS_OTHERS = props;
    return <div />;
}

export function TagWithProp(props) {
    const PARTAS_OTHERS = props;
    return <div class="SomeClass" />;
}

export function TagWithProps(this$) {
    const PARTAS_OTHERS = this$;
    return <div class="SomeClass"
        draggable="true" />;
}
