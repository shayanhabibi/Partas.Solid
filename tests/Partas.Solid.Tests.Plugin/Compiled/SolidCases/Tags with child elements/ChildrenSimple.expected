

export function TypeDefTest(props) {
    const PARTAS_OTHERS = props;
    return <button>
        Button
    </button>;
}

export function TypeDefTestWithProps(props) {
    const PARTAS_OTHERS = props;
    return <button class="ButtonClass"
        draggable="true">
        Button
        <span class="sr-only">
            Span
        </span>
    </button>;
}

export function TypeDefTestWithExtensions(props) {
    const PARTAS_OTHERS = props;
    return <button class="ButtonClass"
        Key="Value">
        Button
        <span class="sr-only">
            Span
        </span>
        <div class="DivBelow"
            key="value" />
        TextBelow
    </button>;
}

